[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/parts/skip_summary.gd" id="1_ss"]
[ext_resource type="Script" path="res://scenes/ui/parts/hint_bar.gd" id="2_hb"]

[node name="SkipSummary" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_ss")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.169, 0.169, 0.169, 0.55)

[node name="Centre" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 2

[node name="Card" type="PanelContainer" parent="Centre"]
custom_minimum_size = Vector2(760, 0)
layout_mode = 2
theme_type_variation = &"Card"

[node name="Box" type="VBoxContainer" parent="Centre/Card"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Centre/Card/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "UI_SUMMARY_TITLE"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Body" type="Label" parent="Centre/Card/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
theme_override_constants/line_spacing = 6
theme_override_font_sizes/font_size = 21
autowrap_mode = 3

[node name="Spacer" type="Control" parent="Centre/Card/Box"]
custom_minimum_size = Vector2(0, 6)
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="Centre/Card/Box"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="Stay" type="Button" parent="Centre/Card/Box/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(210, 0)
layout_mode = 2
text = "UI_SKIP_STAY"

[node name="Skip" type="Button" parent="Centre/Card/Box/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(210, 0)
layout_mode = 2
text = "UI_SKIP_CHAPTER"

[node name="Hints" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
mouse_filter = 2
script = ExtResource("2_hb")

[connection signal="pressed" from="Centre/Card/Box/Row/Stay" to="." method="_on_stay_pressed"]
[connection signal="pressed" from="Centre/Card/Box/Row/Skip" to="." method="_on_skip_pressed"]
