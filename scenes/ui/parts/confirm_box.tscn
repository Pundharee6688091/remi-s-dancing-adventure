[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/parts/confirm_box.gd" id="1_cb"]
[ext_resource type="Script" path="res://scenes/ui/parts/hint_bar.gd" id="2_hb"]

[node name="ConfirmBox" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_cb")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.169, 0.169, 0.169, 0.35)

[node name="Centre" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Card" type="PanelContainer" parent="Centre"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
theme_type_variation = &"Card"

[node name="Box" type="VBoxContainer" parent="Centre/Card"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Centre/Card/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
horizontal_alignment = 1
autowrap_mode = 3

[node name="Body" type="Label" parent="Centre/Card/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.34901962, 0.34117648, 0.32156864, 1)
horizontal_alignment = 1
autowrap_mode = 3

[node name="Spacer" type="Control" parent="Centre/Card/Box"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="Centre/Card/Box"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="No" type="Button" parent="Centre/Card/Box/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2

[node name="Yes" type="Button" parent="Centre/Card/Box/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
theme_type_variation = &"Danger"

[node name="Hints" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
mouse_filter = 2
script = ExtResource("2_hb")

[connection signal="pressed" from="Centre/Card/Box/Row/No" to="." method="_on_no_pressed"]
[connection signal="pressed" from="Centre/Card/Box/Row/Yes" to="." method="_on_yes_pressed"]
